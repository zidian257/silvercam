{
  "name": "actpipe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Action 5 Pro + FIT dashboard overlay pipeline: resident server + thin CLI + ffmpeg",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node --experimental-strip-types src/server/index.ts",
    "cli": "node --experimental-strip-types bin/actpipe.ts",
    "build:cli": "bun build --compile --minify bin/actpipe.ts --outfile actpipe",
    "fixtures": "node fixtures/make-fixtures.mjs",
    "test": "node --experimental-strip-types --test \"test/server/**/*.test.ts\"",
    "test:web": "vitest run",
    "typecheck": "tsc --noEmit",
    "typecheck:web": "svelte-check --tsconfig ./tsconfig.web.json",
    "build:web": "vite build",
    "dev:web": "vite"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.85.1",
    "@earendil-works/pi-ai": "^0.85.1",
    "@feathersjs/errors": "^5.0.49",
    "@feathersjs/express": "^5.0.49",
    "@feathersjs/feathers": "^5.0.49",
    "@feathersjs/socketio": "^5.0.49",
    "@garmin/fitsdk": "^21.214.0",
    "chokidar": "^4.0.0",
    "esbuild": "^0.28.2",
    "esbuild-svelte": "^0.9.5",
    "lucide-svelte": "^1.0.1",
    "playwright": "^1.47.0",
    "socket.io": "^4.8.3",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^26.5.1",
    "jsdom": "^30.0.1",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
